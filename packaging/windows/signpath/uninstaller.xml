<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "uninstaller": paste into the SignPath project (see README.md here). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <!-- Inno Setup's uninst-*.e32, renamed to .exe for signing by build.yml. -->
    <pe-file path="uninst-*.exe" product-name="Live Translate" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
